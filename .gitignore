# Root .gitignore
# This file handles root-level ignores

# Build logs
*.log
build*.log
final_build.log

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# Node (if any at root)
node_modules/

# Environment
.env
.env.local
.env.*.local

# Lock files (optional - remove if you want to track)
# package-lock.json
# yarn.lock

# Misc
*.tmp
*.bak
dist/
coverage/
