# Root .gitignore
# This file handles root-level ignores

# Build logs
*.log
build*.log
final_build.log

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# Node (if any at root)
node_modules/

# Environment (never commit real secrets)
**/.env
**/.env.*
**/.env.local
**/.env.*.local

# Allow safe templates to be committed
!**/.env.example
!**/.env*.example

# Lock files (optional - remove if you want to track)
# package-lock.json
# yarn.lock

# Misc
*.tmp
*.bak
dist/
coverage/
